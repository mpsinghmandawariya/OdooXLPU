{
  "name": "stocksense",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "postinstall": "npm run prisma:generate --workspace=stocksense-backend",
    "dev": "concurrently -k -n backend,frontend -c cyan,magenta \"npm run dev --workspace=stocksense-backend\" \"npm run dev --workspace=frontend\"",
    "dev:backend": "npm run dev --workspace=stocksense-backend",
    "dev:frontend": "npm run dev --workspace=frontend",
    "start": "npm run start --workspace=stocksense-backend",
    "build": "npm run build --workspace=frontend"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}

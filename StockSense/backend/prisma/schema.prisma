generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  INVENTORY_MANAGER
  WAREHOUSE_STAFF
}

enum OperationType {
  RECEIPT
  DELIVERY
  TRANSFER
  INTERNAL_TRANSFER
  ADJUSTMENT
}

enum OperationStatus {
  DRAFT
  READY
  COMPLETED
  CANCELLED
}

enum MoveType {
  IN
  OUT
  TRANSFER
  ADJUSTMENT
}

model User {
  id           String   @id @default(uuid())
  loginId      String   @unique
  email        String   @unique
  passwordHash String

  role         UserRole @default(INVENTORY_MANAGER)
  isActive     Boolean  @default(true)

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  otpRecords   PasswordResetOTP[]
  operations   InventoryOperation[] @relation("CreatedOperations")
  stockMoves   StockMove[]

  @@index([email])
  @@index([loginId])
  @@map("users")
}

model PasswordResetOTP {
  id        String   @id @default(uuid())

  userId    String
  otpHash   String

  expiresAt DateTime
  attempts  Int      @default(0)
  used      Boolean  @default(false)

  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_otps")
}

model Category {
  id          String   @id @default(uuid())

  name        String   @unique
  description String?

  isActive    Boolean  @default(true)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products    Product[]

  @@index([name])
  @@index([isActive])
  @@map("categories")
}

model Product {
  id            String   @id @default(uuid())

  sku           String   @unique
  name          String
  description   String?

  categoryId    String
  unitOfMeasure String
  unitPrice     Decimal  @db.Decimal(12, 2)

  isActive      Boolean  @default(true)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  category      Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  stockBalances StockBalance[]
  operations    InventoryOperation[]
  stockMoves    StockMove[]

  @@index([name])
  @@index([sku])
  @@index([categoryId])
  @@index([isActive])
  @@map("products")
}

model Warehouse {
  id          String   @id @default(uuid())

  code        String   @unique
  name        String
  location    String?

  isActive    Boolean  @default(true)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  locations   Location[]
  operations  InventoryOperation[]

  @@index([name])
  @@map("warehouses")
}

model Location {
  id          String   @id @default(uuid())

  name        String
  shortCode   String

  warehouseId String
  isActive    Boolean  @default(true)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  warehouse             Warehouse            @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  operations            InventoryOperation[]
  sourceOperations      InventoryOperation[] @relation("SourceLocation")
  destinationOperations InventoryOperation[] @relation("DestinationLocation")
  stockBalances         StockBalance[]
  outgoingMoves         StockMove[]          @relation("MoveSource")
  incomingMoves         StockMove[]          @relation("MoveDestination")

  @@unique([warehouseId, shortCode])
  @@index([warehouseId])
  @@index([name])
  @@map("locations")
}

model StockBalance {
  id               String   @id @default(uuid())

  productId        String
  locationId       String

  quantity         Decimal  @default(0) @db.Decimal(14, 3)
  reservedQuantity Decimal  @default(0) @db.Decimal(14, 3)

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  product          Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  location         Location @relation(fields: [locationId], references: [id], onDelete: Restrict)

  @@unique([productId, locationId])
  @@index([productId])
  @@index([locationId])
  @@map("stock_balances")
}

// Central stock ledger — every stock change creates a StockMove
model StockMove {
  id                    String    @id @default(uuid())

  reference             String

  productId             String
  quantity              Decimal   @db.Decimal(14, 3)
  moveType              MoveType

  sourceLocationId      String?
  destinationLocationId String?

  // Link back to the originating operation
  operationId           String?
  operationType         OperationType?

  contact               String?
  notes                 String?

  createdById           String
  createdAt             DateTime  @default(now())

  product               Product   @relation(fields: [productId], references: [id], onDelete: Restrict)
  sourceLocation        Location? @relation("MoveSource", fields: [sourceLocationId], references: [id], onDelete: Restrict)
  destinationLocation   Location? @relation("MoveDestination", fields: [destinationLocationId], references: [id], onDelete: Restrict)
  createdBy             User      @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@index([productId])
  @@index([operationId])
  @@index([createdAt])
  @@index([moveType])
  @@map("stock_moves")
}

model InventoryOperation {
  id                    String          @id @default(uuid())

  type                  OperationType
  status                OperationStatus @default(DRAFT)

  referenceNumber       String          @unique

  // Who the operation is with (supplier name for receipts, customer for deliveries)
  contact               String?

  productId             String
  warehouseId           String?
  locationId            String?
  sourceLocationId      String?
  destinationLocationId String?

  quantity              Decimal         @db.Decimal(14, 3)
  unitCost              Decimal?        @db.Decimal(12, 2)

  scheduledDate         DateTime?
  completedAt           DateTime?
  notes                 String?

  createdById           String

  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  product               Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  warehouse             Warehouse?      @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  location              Location?       @relation(fields: [locationId], references: [id], onDelete: Restrict)
  sourceLocation        Location?       @relation("SourceLocation", fields: [sourceLocationId], references: [id], onDelete: Restrict)
  destinationLocation   Location?       @relation("DestinationLocation", fields: [destinationLocationId], references: [id], onDelete: Restrict)
  createdBy             User            @relation("CreatedOperations", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([type])
  @@index([status])
  @@index([productId])
  @@index([createdAt])
  @@index([scheduledDate])
  @@index([warehouseId])
  @@index([locationId])
  @@map("inventory_operations")
}
